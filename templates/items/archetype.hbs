<div class="item-sheet-content o13-sheet o13-sheet-lining flexcol">
	<header class="sheet-header flexrow">
		<div class="o13-portrait-container">
			<img class="o13-portrait" name="img" src="{{item.img}}" title="{{item.name}}" alt="{{item.name}}" data-action="choosePortrait" />
		</div>
		<div class="flexcol">
			<div class="form-group flexrow">
				<label for="item-name" class="o13-label" style="flex:0.5"><b>{{localize "13omens.titles.name"}}:</b></label>
				<input class="o13-input o13-underline" type="text" name="name" value="{{item.name}}" />
			</div>
		</div>
	</header>
	<main class="flexcol">
		<nav class="o13-nav" nav-group="main" style="margin-bottom:2px">
			<a data-group="main" nav-tab="perksandgear">{{localize "13omens.titles.perksandgear"}}</a>
			<a data-group="main" nav-tab="background">{{localize "13omens.titles.background"}}</a>
		</nav>
	
		<section class="o13-tab o13-scrollable flexcol" nav-group="main" nav-tab="perksandgear" scroll-id="perksandgear">
			{{> "systems/13omens/templates/items/components/archetype_perksngear.hbs" 
				item=item
			}}
		</section>
		
		<section class="o13-tab o13-scrollable flexcol" nav-group="main" nav-tab="background" scroll-id="background">
			{{> "systems/13omens/templates/items/components/archetype_background.hbs" 
				item=item
				enriched=enriched
			}}
		</section>
	</main>
</div>