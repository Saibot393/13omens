<div class="item-sheet-content o13-sheet o13-sheet-lining flexcol">
	<header class="sheet-header flexrow">
		<div class="o13-portrait-container">
			<img class="o13-portrait" name="img" src="{{item.img}}" title="{{item.name}}" alt="{{item.name}}" data-action="choosePortrait" />
			<i class="fa-solid fa-image o13-icon o13-bottom-right o13-hover-icon o13-clickable" data-action="viewPortrait" data-tooltip="{{localize "13omens.tooltips.viewPortrait"}}"></i>
		</div>
		<div class="flexcol">
			<div class="form-group flexrow">
				<label for="item-name" class="o13-label" style="flex:0.5"><b>{{localize "13omens.titles.name"}}:</b></label>
				<input class="o13-input o13-underline" type="text" name="name" value="{{item.name}}" />
			</div>
			<div class="form-group flexrow">
				<label for="gear-uses" class="o13-label" style="flex:0.5"><b>{{localize "13omens.titles.uses.name"}}:</b></label>
				<span class="o13-input-span o13-label">
					{{#unless (eq "passive" item.system.usesper.per)}}
						{{!-- probably no inpit for current uses required
						<input class="o13-input o13-underline" type="number" name="system.usesper.value" value="{{item.system.usesper.value}}" />
						/
						--}}
						<input class="o13-input o13-underline" type="number" name="system.usesper.max" value="{{item.system.usesper.max}}" />
					{{/unless}}
					<select class="o13-input o13-underline o13-bottom-align" name="system.usesper.per">
					{{#each item.usesPerOptions as |perOption|}}
						<option value="{{perOption}}" {{#if (eq perOption ../item.system.usesper.per)}}selected{{/if}}>{{localize (concat "13omens.titles.uses.per." perOption)}}</option>
					{{/each}}
					</select>
				</span>
			</div>
		</div>
	</header>
	<main class="flexcol o13-scrollable" style="flex:1; min-height:0;">
		<nav class="o13-nav" nav-group="main" style="margin-bottom:2px">
			<a data-group="main" nav-tab="description">{{localize "13omens.titles.description"}}</a>
			<a data-group="main" nav-tab="activeeffects">{{localize "DOCUMENT.ActiveEffects"}}</a>
		</nav>
		
		<section class="o13-tab o13-scrollable flexcol" nav-group="main" nav-tab="description" scroll-id="description">
			<div class="o13-notes flexcol">
				<prose-mirror class="o13-text-editor" name="system.description" document-uuid="{{item.uuid}}" value="{{item.system.description}}" button toggled editable collaborative="false">
					{{{enriched.description}}}
				</prose-mirror>
			</div>
		</section>
		
		<section class="o13-tab o13-scrollable flexcol" nav-group="main" nav-tab="activeeffects" scroll-id="description">
			<div>
				<span class="o13-label o13-header-label">{{localize "DOCUMENT.ActiveEffects"}} <i class="fa-solid fa-plus o13-icon o13-clickable" data-action="createNewEffect"></i> </span>
				{{#each item.effects}}
					<div class="flexrow o13-side-padding draggable" draggable="true" effect-id="{{this._id}}">
						<span class="o13-underline o13-flex-span">
							<span class="o13-label o13-clickable o13-flex-grow" effect-id="{{this._id}}" data-action="openEffect">
								{{this.name}}
							</span>
							<i class="fa-solid fa-x o13-label o13-icon o13-clickable o13-flex-right" effect-id="{{this._id}}" data-action="removeEffect"></i>
						</span>
					</div>
				{{/each}}
			</div>
		</section>
	</main>
</div>