<div class="o13-die" die-face="{{face}}" {{#if mystery}}mystery{{/if}} die-type="{{type}}">
	<div class="o13-pip pip-top-left"></div>
	<div class="o13-pip pip-top-right"></div>
	<div class="o13-pip pip-mid-left"></div>
	<div class="o13-pip pip-mid-mid"></div>
	<div class="o13-pip pip-mid-right"></div>
	<div class="o13-pip pip-bot-left"></div>
	<div class="o13-pip pip-bot-right"></div>
	{{#unless mystery}}
		{{#if crossed}}
			<img class="o13-overlay o13-overlay o13-transparent-hover" src="systems/13omens/assets/icons/cross-mark.svg"/>
		{{/if}}
	{{/unless}}
	{{#if (or skulled mystery)}}
		<img class="o13-overlay o13-overlay {{#unless mystery}}o13-transparent-hover{{/unless}}" src="systems/13omens/assets/icons/death-skull.svg"/>
	{{/if}}
</div>