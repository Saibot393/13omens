<div class="o13-sheet">
	<div class="flexcol">
		<div class="flexrow">
			<span class="o13-label o13-content-centered"><b>{{config.aspectName}} - {{localize (concat "13omens.titles.ratings." config.aspectRating)}}</b></span>
			<span class="o13-label o13-content-centered"><b>{{localize "13omens.titles.tn"}}: {{config.targetNumber}}</b></span>
		</div>
		<div class="flexrow">
			<div class="flexrow">
				<label class="o13-label o13-content-centered">{{localize "13omens.titles.taskRisk"}}:
				{{#if config.hostView}}
					</label>
					<select class="o13-input o13-underline o13-smalltext" name="taskRisk">
						{{#each taskRisks as |risk|}}
							<option value="{{risk}}" {{#if (eq risk ../config.taskRisk)}}selected{{/if}}>{{localize (concat "13omens.titles.taskrisks." risk)}}</option>
						{{/each}}
					</select>
				{{else}}
					{{localize (concat "13omens.titles.taskrisks." config.taskRisk)}}
					</label>
				{{/if}}
			</div>
			<label class="o13-label o13-content-centered">{{localize "13omens.titles.taskDifficulty"}}: {{#if config.hostView}}<i class="fa-solid fa-minus o13-smalltext" data-action="reduceTaskDifficulty"></i>{{/if}} {{config.taskDifficulty}} {{#if config.hostView}}<i class="fa-solid fa-plus o13-smalltext" data-action="increaseTaskDifficulty"></i>{{/if}} </b></label>
		</div>
		<div class="flexrow">
			<div class="flexcol o13-flexStart">
				<span class="o13-header-label o13-content-centered">{{localize "13omens.titles.flaws"}} <i class="fa-solid fa-plus" data-action="addEmptyFlaw"></i></span>
				{{#if config.strain}}
					{{#unless config.ignoreStrain}}
						<div class="flexrow o13-padding">
							<input class="o13-input o13-underline" type="text" index="{{@key}}" value="{{localize "13omens.titles.strain"}}" style="width:80%" disabled />
							<i class="fa-solid fa-x o13-label o13-lowflex" data-action="disableFlaw"></i>
						</div>
					{{/unless}}
				{{/if}}
				{{#each config.flaws as |flaw|}}
					<div class="flexrow o13-padding">
						<input class="o13-input o13-underline" type="text" index="{{@key}}" name="{{concat "flaws." @key ".name"}}" value="{{flaw.name}}" />
						<i class="fa-solid fa-x o13-label o13-lowflex" data-action="removeFlaw"></i>
					</div>
				{{/each}}
			</div>
			<div class="flexcol o13-flexStart">
				<span class="o13-header-label o13-content-centered">{{localize "13omens.titles.edges"}} <i class="fa-solid fa-plus" data-action="addEmptyEdge"></i></span>
				{{#each config.edges as |edge|}}
					<div class="flexrow o13-padding">
						<input class="o13-input o13-underline" type="text" index="{{@key}}" name="{{concat "edges." @key ".name"}}" value="{{edge.name}}" />
						<i class="fa-solid fa-x o13-label o13-lowflex" index="{{@key}}" data-action="removeEdge"></i>
					</div>
				{{/each}}
			</div>
		</div>
		<button data-action="roll">{{localize "13omens.titles.roll"}} <i class="fa-solid fa-dice"></i> </button>
	</div>
</div>