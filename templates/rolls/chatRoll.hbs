		<div style="height : 40px">
			{{> "systems/13omens/templates/dice/dicebar.hbs" 
				dice=roll.diceResults
			}}
		</div>
		<label class="o13-label o13-content-centered o13-header-label" style="margin-top:5px">{{{localize "13omens.titles.rollResult" taskrisk=(localize (concat "13omens.titles.taskrisks." roll.taskRisk)) outcome=(localize (concat "13omens.titles.outcomes." roll.outcome))}}}</label>
	</div>
</div>
