<div class="o13-sheet o13-bordered">
	<div class="flexcol">
		<span class="o13-label" style="text-align:center;margin-bottom:5px">{{{localize "13omens.chats.actorRolled" actor=roll.actorName aspect=roll.aspectName with=roll.FEDescription tn=roll.totalDifficulty}}}</span>
		<div style="height : 40px">
			{{> "systems/13omens/templates/dice/dicebar.hbs" 
				dice=roll.diceResults
			}}
		</div>
		{{#unless roll.canValiantSacrifice}}
			{{#unless roll.hasValiantlySacrificed}}
				<span class="o13-label o13-content-centered">
					{{#if roll.hasRerolls}}<i class="fa-solid fa-dice" data-tooltip="{{localize '13omens.tooltips.reroll'}}" style="margin:10px;color:var(--o13-antique-gold);" data-action="rerollDice"></i>{{/if}}
					{{#if roll.canOmenRedraw}}<i class="fa-solid fa-sack-xmark" data-tooltip="{{localize '13omens.tooltips.redrawomen'}}" style="margin:10px;color:var(--o13-antique-gold);" data-action="redrawOmenDice"></i>{{/if}}
				</span>
			{{/unless}}
			<span class="o13-label o13-content-centered o13-header-label" style="margin-top:5px">
				{{{localize "13omens.chats.rollResult" taskrisk=(localize (concat "13omens.titles.taskrisks." roll.taskRisk)) outcome=(localize (concat "13omens.titles.outcomes." roll.outcome))}}}
				{{#if roll.isOwner}}
					{{#if roll.canTakeConsequence}}
						{{#if roll.hasWound}}
							<i class="fa-solid fa-droplet" style="color:var(--o13-omen-red)" data-action="takeWound" data-tooltip="{{localize '13omens.tooltips.takeWound'}}"></i>
							{{#if roll.canCheatDeath}}
								<i class="fa-solid fa-hourglass-half" style="color:var(--o13-cheat-blue)" data-action="cheatDeath" data-tooltip="{{localize '13omens.tooltips.cheatDeath'}}"></i>
							{{/if}}
						{{/if}}
						{{#if roll.hasStrain}}
							<i class="fa-solid fa-bolt-lightning" style="color:var(--o13-strain-yellow)" data-action="takeStrain" data-tooltip="{{localize '13omens.tooltips.takeStrain'}}"></i>
						{{/if}}
					{{/if}}
				{{/if}}
			</span>
		{{else}}
			<span class="o13-label o13-content-centered o13-header-label" style="margin-top:5px">
				{{localize "13omens.chats.sacrificeValiantly"}}
				<i class="fa-solid fa-skull" style="color:var(--o13-omen-red)" data-action="valiantlysacrifice" data-tooltip="{{localize '13omens.tooltips.takeValiantSacrifice'}}"></i>
				<i class="fa-solid fa-dice" style="color:var(--o13-cheat-blue)" data-action="refusevaliantsacrifice" data-tooltip="{{localize '13omens.tooltips.refuseValiantSacrifice'}}"></i>
			</span>
		{{/unless}}
	</div>
</div>