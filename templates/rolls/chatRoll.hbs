<div class="o13-sheet o13-bordered">
	<div class="flexcol">
		<span class="o13-label" style="text-align:center;margin-bottom:5px">{{{localize "13omens.titles.actorRolled" actor=roll.actorName aspect=roll.aspectName with=roll.FEDescription tn=roll.totalDifficulty}}}</span>
		<div style="height : 40px">
			{{> "systems/13omens/templates/dice/dicebar.hbs" 
				dice=roll.diceResults
			}}
		</div>
		<span class="o13-label o13-content-centered o13-header-label" style="margin-top:5px">
			{{{localize "13omens.titles.rollResult" taskrisk=(localize (concat "13omens.titles.taskrisks." roll.taskRisk)) outcome=(localize (concat "13omens.titles.outcomes." roll.outcome))}}}
			{{#if flags.canTakeConsequence}}
				{{#if roll.hasWound}}
					{{#if roll.woundisStrain}}
						<i class="fa-solid fa-bolt-lightning o13-button" style="color:var(--o13-strain-yellow)" data-action="takeStrain" data-tooltip="{{localize '13omens.tooltips.takeStrain'}}"></i>
					{{else}}
						<i class="fa-solid fa-droplet o13-button" style="color:var(--o13-omen-red)" data-action="takeWound" data-tooltip="{{localize '13omens.tooltips.takeWound'}}"></i>
						{{#if roll.canCheatDeath}}
							<i class="fa-solid fa-hourglass-half o13-button" style="color:var(--o13-cheat-blue)" data-action="cheatDeath" data-tooltip="{{localize '13omens.tooltips.cheatDeath'}}"></i>
						{{/if}}
					{{/if}}
				{{/if}}
			{{/if}}
		</span>
	</div>
</div>