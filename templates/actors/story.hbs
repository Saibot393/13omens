<div class="actor-sheet-content o13-sheet o13-sheet-lining flexcol">
	<header class="sheet-header flexrow">
		<div class="o13-portrait-container">
			<img class="o13-portrait" name="img" src="{{actor.img}}" title="{{actor.name}}" alt="{{actor.name}}" data-action="choosePortrait" />
		</div>
		
		<div class="flexcol">
			<div class="form-group flexrow" style="margin-bottom:15px">
				<label for="actor-name" class="o13-label" style="flex:0.25"><b>{{localize "13omens.titles.name"}}:</b></label>
				<input class="o13-input o13-underline" type="text" name="name" value="{{actor.name}}" />
			</div>
			
			<div class="flexrow" style="justify-content:center">
				<span class="o13-label o13-act-title" style="display:inline-flex;justify-content:center;white-space : nowrap;">
					<b>{{localize (concat "13omens.titles.actNames." actor.activeAct)}}</b>
				</span>
				{{#if actor.isHostView}}
					<div class="flexcol {{#unless actor.isPrologue}}o13-hover-div{{/unless}}" style="flex:0.1">
						{{#if actor.isPrologue}}
							<i class="fa-solid fa-play o13-icon o13-clickable" style="color:var(--o13-omen-red)" data-action="advanceAct"></i>
						{{else}}
							<i class="fa-solid fa-rotate-left o13-icon o13-clickable" style="color:var(--o13-ink-black)" data-action="resettoPrologue"></i>
							<i class="fa-solid fa-right-long o13-icon o13-clickable" style="color:var(--o13-omen-red)" data-action="advanceAct"></i>
						{{/if}}
					</div>
				{{/if}}
			</div>
			
			{{#if actor.isHostView}}
				{{#if actor.isPrologue}}
					<div class="flexcol o13-bordered o13-hover-div" style="margin:auto;min-width:350px">
						<div class="flexrow">
							<div class="form-group">
								<label for="actor-autoprogressacts" class="o13-label">{{localize "13omens.titles.autoProgressActs"}}:</label>
								<input class="o13-checkbox" type="checkbox" name="system.autoprogressacts" {{checked actor.autoProgressActs}}/>
							</div>
							<div class="form-group">
								<label for="actor-autoprogressacts" class="o13-label">{{localize "13omens.titles.addOmenDiceonActStart"}}:</label>
								<input class="o13-checkbox" type="checkbox" name="system.addomendiceonactstart" {{checked actor.addOmenDiceonActStart}}/>
							</div>
						</div>
						{{#if actor.autoProgressActs}}
							<div class="flexrow">
								<span class="o13-label" style="flex:0.7;margin-right:20px">{{localize "13omens.titles.thresholds"}}:</span>
								<span class="o13-label o13-input-span">{{localize "13omens.titles.actNames.2"}}:<input class="o13-input o13-underline" type="number" name="system.acts.2.omenDiceThreshold" value="{{actor.system.acts.2.omenDiceThreshold}}"/></span>
								<span class="o13-label o13-input-span">{{localize "13omens.titles.actNames.3"}}:<input class="o13-input o13-underline" type="number" name="system.acts.3.omenDiceThreshold" value="{{actor.system.acts.3.omenDiceThreshold}}"/></span>
							</div>
						{{/if}}
					</div>
				{{/if}}
			{{/if}}
		</div>
	</header>
	
	<main class="flexcol">
		<nav class="o13-nav" nav-group="main">
			<a data-group="main" nav-tab="game">{{localize "13omens.titles.game"}}</a>
			<a data-group="main" nav-tab="story">{{localize "13omens.titles.story"}}</a>
		</nav>
		
		<section class="o13-tab o13-scrollable flexcol" nav-group="main" nav-tab="game" scroll-id="game">
			{{> "systems/13omens/templates/actors/components/story_game.hbs" 
				actor=actor
			}}
		</section>
		
		<section class="o13-tab o13-scrollable flexcol" nav-group="main" nav-tab="story" scroll-id="story">
			{{> "systems/13omens/templates/actors/components/story_story.hbs" 
				actor=actor
				enriched=enriched
			}}
		</section>
	</main>
</div>