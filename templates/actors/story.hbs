<div class="actor-sheet-content o13-sheet o13-sheet-lining flexcol">
	<header class="sheet-header flexrow">
		<div class="o13-portrait-container">
			<img class="o13-portrait" name="img" src="{{actor.img}}" title="{{actor.name}}" alt="{{actor.name}}" data-action="choosePortrait" />
		</div>
		
		<div class="form-group flexrow">
			<label for="actor-name" class="o13-label" style="flex:0.5"><b>{{localize "13omens.titles.name"}}:</b></label>
			<input class="o13-input o13-underline" type="text" name="name" value="{{actor.name}}" />
		</div>
		
		<div class="flexrow" style="justify-content:center">
			<span class="o13-label o13-act-title" style="display:inline-flex;justify-content:center;white-space : nowrap;">
				<b>{{localize (concat "13omens.titles.actNames." actor.activeAct)}}</b>
			</span>
			{{#if actor.isHostView}}
			<div class="flexcol {{#unless actor.isPrologue}}o13-hover-div{{/unless}}" style="flex:0.1">
				{{#if actor.isPrologue}}
					<i class="fa-solid fa-play o13-icon o13-clickable" style="color:var(--o13-omen-red)" data-action="advanceAct"></i>
				{{else}}
					<i class="fa-solid fa-rotate-left o13-icon o13-clickable" style="color:var(--o13-ink-black)" data-action="resettoPrologue"></i>
					<i class="fa-solid fa-right-long o13-icon o13-clickable" style="color:var(--o13-omen-red)" data-action="advanceAct"></i>
				{{/if}}
			</div>
			{{/if}}
		</div>
	</header>
	
	<main class="o13-scrollable" style="flex:1" scroll-id="main">
		<div class="flexcol">
			<div class="flexrow">
				<div class="flexcol o13-flexStart">
					<span class="o13-label o13-header-label o13-content-centered">{{localize "13omens.titles.hostomendice"}}</span>
					<div>
						{{> "systems/13omens/templates/dice/dicebag.hbs" 
							dice=actor.hostOmenDice
						}}
					</div>
				</div>
				{{#if actor.isHostView}}
					<div class="flexcol o13-minflex">
						{{#if actor.canAddOmenDice}}<i class="fa-solid fa-right-long o13-icon o13-clickable" style="color:var(--o13-omen-red);" data-action="addOmenDice"></i>{{/if}}
						{{#if actor.canRemoveOmenDice}}<i class="fa-solid fa-left-long o13-icon o13-clickable"  style="color:var(--o13-omen-red);" data-action="removeOmenDice"></i>{{/if}}
					</div>
				{{/if}}
				<div class="flexcol o13-flexStart">
					<span class="o13-label o13-header-label o13-content-centered">{{localize "13omens.titles.dicebag"}}</span>
					<div>
						{{> "systems/13omens/templates/dice/dicebag.hbs" 
							dice=actor.diceBagDice
						}}
					</div>
				</div>
			</div>
			{{#if actor.isHostView}}
				<div class="flexrow" style="flex-wrap:nowrap;margin-bottom:15px">
					<div class="flexcol o13-flexStart">
						<span class="o13-label o13-header-label o13-content-centered">{{localize "13omens.titles.storyAspects"}}</span>
						{{#each actor.system.storyaspects as |aspect|}}
							<input class="o13-input o13-underline" type="text" name="{{concat "system.storyaspects." @key ".name"}}" value="{{aspect.name}}" />
						{{/each}}
					</div>
					<div class="flexcol o13-flexStart" style="flex:1.5">
						<span class="o13-label o13-header-label o13-content-centered">{{localize "13omens.titles.archetypes"}} <i class="fa-solid fa-plus o13-clickable" data-action="createNewArchetype"></i></span>
						{{#each actor.archetypes as |archetype|}}
							<div class="flexrow o13-padding">
								<span class="o13-label o13-clickable o13-content-centered" type="text" archetype-id="{{archetype.id}}" data-action="openArchetype">{{archetype.name}}</span>
								<select class="o13-input o13-underline" name="{{concat "system.archetypeaspects." archetype.id}}">
									<option value="-1"></option>
									{{#each actor.system.storyaspects as |aspect|}}
										{{#if aspect.name}}
											<option value="{{@key}}" {{#if (eqLoose @key (lookup @root.actor.system.archetypeaspects archetype.id))}}selected{{/if}}>{{aspect.name}}</option>
										{{/if}}
									{{/each}}
								</select>
								<i class="fa-solid fa-x o13-label o13-icon o13-clickable o13-lowflex" archetype-id="{{archetype.id}}" data-action="deleteArchetype"></i>
							</div>
						{{/each}}
					</div>
				</div>
				<div class="flexcol">
					<span class="o13-label o13-header-label o13-flex-span">{{localize "13omens.titles.players"}} <i class="fa-solid fa-people-group o13-flex-right o13-icon o13-clickable" data-action="autoPopulatePCs" style="flex:1" data-tooltip="{{localize '13omens.tooltips.createPCs'}}"></i></span>
					{{#each actor.pcActors as |pc|}}
						<div class="flexrow">
							<span class="o13-label o13-clickable o13-content-centered" type="text" pc-id="{{pc.id}}" data-action="openPC">{{pc.name}}</span>
							<span class="o13-label o13-content-centered" type="text" pc-id="{{pc.id}}" >{{pc.archetype.name}}</span>
							{{> "systems/13omens/templates/dice/dicebar.hbs" 
								dice=pc.woundDice
								microdice=true
							}}
							<i class="fa-solid fa-x o13-label o13-icon o13-clickable o13-lowflex" pc-id="{{pc.id}}" data-action="removePC"></i>
						</div>
					{{/each}}
				</div>
			{{/if}}
		</div>
	</main>
</div>