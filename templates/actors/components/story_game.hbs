<div class="flexcol" style="margin-top:3px">
	<div class="flexrow">
		<div class="flexcol o13-flexStart">
			<span class="o13-label o13-header-label o13-content-centered">{{localize "13omens.titles.hostomendice"}}</span>
			<div>
				{{> "systems/13omens/templates/dice/dicebag.hbs" 
					dice=actor.hostOmenDice
				}}
			</div>
		</div>
		{{#if actor.isHostView}}
			<div class="flexcol o13-minflex" style="align-self:flex-start;">
				<div style="height:30px;"></div>
				{{#if actor.canAddOmenDice}}<i class="fa-solid fa-right-long o13-icon o13-clickable" style="color:var(--o13-omen-red);margin-bottom:10px;" data-action="addOmenDice"></i>{{/if}}
				{{#if actor.canRemoveOmenDice}}<i class="fa-solid fa-left-long o13-icon o13-clickable"  style="color:var(--o13-omen-red);" data-action="removeOmenDice"></i>{{/if}}
			</div>
		{{/if}}
		<div class="flexcol o13-flexStart">
			<span class="o13-label o13-header-label o13-content-centered">{{localize "13omens.titles.dicebag"}}</span>
			<div>
				{{> "systems/13omens/templates/dice/dicebag.hbs" 
					dice=actor.diceBagDice
				}}
			</div>
		</div>
	</div>
	{{#if actor.isHostView}}
		<div class="flexrow" style="flex-wrap:nowrap;margin-bottom:15px">
			<div class="flexcol o13-flexStart">
				<span class="o13-label o13-header-label o13-content-centered">{{localize "13omens.titles.storyAspects"}}</span>
				{{#each actor.system.storyaspects as |aspect|}}
					<input class="o13-input o13-underline" type="text" name="{{concat "system.storyaspects." @key ".name"}}" value="{{aspect.name}}" />
				{{/each}}
			</div>
			<div class="flexcol o13-flexStart" style="flex:1.5" sort-direction="t_b" sort-behaviour="AUTO">
				<span class="o13-label o13-header-label o13-content-centered">{{localize "13omens.titles.archetypes"}} <i class="fa-solid fa-plus o13-clickable" data-action="createNewArchetype"></i></span>
				{{#each actor.archetypes as |archetype|}}
					<div class="flexrow o13-padding o13-sortable draggable" draggable="true" archetype-id="{{archetype.id}}">
						<span class="o13-label o13-clickable o13-content-centered" type="text" archetype-id="{{archetype.id}}" data-action="openArchetype">{{archetype.name}}</span>
						<select class="o13-input o13-underline" name="{{concat "system.archetypeaspects." archetype.id}}">
							<option value="-1"></option>
							{{#each actor.system.storyaspects as |aspect|}}
								{{#if aspect.name}}
									<option value="{{@key}}" {{#if (eqLoose @key (lookup @root.actor.system.archetypeaspects archetype.id))}}selected{{/if}}>{{aspect.name}}</option>
								{{/if}}
							{{/each}}
						</select>
						<i class="fa-solid fa-x o13-label o13-icon o13-clickable o13-lowflex" archetype-id="{{archetype.id}}" data-action="deleteArchetype"></i>
					</div>
				{{/each}}
			</div>
		</div>
		<div class="flexcol" sort-direction="t_b">
			<span class="o13-label o13-header-label o13-flex-span">{{localize "13omens.titles.players"}} <div style="flex:1"></div><i class="fa-solid fa-people-group o13-flex-right o13-icon o13-clickable" data-action="autoPopulatePCs" data-tooltip="{{localize '13omens.tooltips.createPCs'}}"></i></span>
			{{#each actor.pcActors as |pc|}}
				<div class="flexrow o13-sortable draggable" draggable="true" pc-id="{{pc.id}}">
					<span class="o13-label o13-clickable o13-content-centered" type="text" pc-id="{{pc.id}}" data-action="openPC">{{pc.name}}</span>
					<span class="o13-label o13-content-centered" type="text" pc-id="{{pc.id}}" >{{pc.archetype.name}}</span>
					{{!--
						{{> "systems/13omens/templates/dice/dicebar.hbs" 
							dice=pc.woundDice
							microdice=true
						}}
					--}}
					{{> "systems/13omens/templates/dice/minidicebar.hbs" 
						dice=pc.woundDice
					}}
					<i class="fa-solid fa-x o13-label o13-icon o13-clickable o13-lowflex" pc-id="{{pc.id}}" data-action="removePC"></i>
				</div>
			{{/each}}
		</div>
	{{/if}}
</div>