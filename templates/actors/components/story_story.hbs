<nav class="o13-nav" nav-group="story" style="margin-top:3px">
	{{#each actor.system.story.acts}}
		<a data-group="story" nav-tab="{{@key}}" {{#if (eqLoose ../actor.activeAct @key)}}style="color:var(--o13-omen-red)"{{/if}}>{{localize (concat "13omens.titles.actNames." @key)}}</a>
	{{/each}}

    <a data-group="story" nav-tab="credits">{{localize (concat "13omens.titles.credits")}}</a>
</nav>

{{#each actor.system.story.acts}}
	<section class="o13-tab o13-scrollable flexcol" nav-group="story" nav-tab="{{@key}}" scroll-id="story_{{@key}}" style="padding-right:5px;">
		<div class="flexcol">
			<label for="notes" class="o13-label" style="flex:0.5"><b>{{localize "13omens.titles.notes"}}:</b></label>
			<textarea  class="o13-input o13-textarea o13-bordered o13-scrollable" name="system.story.acts.{{@key}}.notes" rows=8" scroll-id="story_{{@key}}_notes" style="flex:none;">{{lookup (lookup ../actor.system.story.acts @key) "notes"}}</textarea>
		</div>
		
		<div class="o13-notes flexcol" style="flex:0.1;min-height:400px;">
			<label for="story" class="o13-label"><b>{{localize "13omens.titles.story"}}:</b></label>
			<prose-mirror class="o13-text-editor" style="min-height:400px;" name="system.story.acts.{{@key}}.story" document-uuid="{{actor.uuid}}" value="{{lookup (lookup ../actor.system.story.acts @key) "story"}}" button toggled editable collaborative="false">
				{{{lookup (lookup ../enriched.story.acts @key) "story"}}}
			</prose-mirror>
		</div>
	</section>
{{/each}}

<section class="o13-tab o13-scrollable flexcol" nav-group="story" nav-tab="credits" scroll-id="story_credits" style="padding-right:5px;">
    <div class="flexcol">
        <div class="flexrow">
            <div class="flexrow" style="min-width:150px">
                <label class="o13-label" style="flex:0.3"><b>{{localize "13omens.titles.duration"}}:</b></label>
                <input class="o13-input o13-underline" type="number" name="system.story.credits.duration" value="{{actor.system.story.credits.duration}}" />
            </div>
            <div class="o13-flex-grow"></div>
            <span class="o13-label o13-button o13-clickable" style="text-align:center" data-action="testCredits">
                {{{localize "13omens.titles.testCredits"}}}
            </span>
            <div class="o13-flex-grow"></div>
            <i class="fa-regular fa-circle-question o13-icon o13-label" data-tooltip="{{{localize "13omens.tooltips.credits"}}}"></i>
        </div>
        <div class="flexrow">
            <label class="o13-label" style="flex:0.3"><b>{{localize "13omens.titles.music"}}:</b></label>
            <input class="o13-input o13-underline" type="text" style="max-width:250px" name="system.story.credits.music" value="{{actor.system.story.credits.music}}"/>
            <span class="o13-label o13-button o13-clickable" style="text-align:center;max-width:28.5px;margin-left:3px;padding:3px" data-action="chooseCreditsMusic" data-tooltip="{{localize "13omens.tooltips.chooseMusic"}}">
                <i class="fa-solid fa-music"></i>
            </span>
            <div class="o13-flex-grow"></div>
        </div>
    </div>

    {{#each actor.system.story.credits.blocks as |block|}}
        <div class="o13-notes flexcol" style="flex:0.1">
            <label class="o13-label"><b>{{localize (concat "13omens.credits." @key)}}:</b></label>
            <textarea  class="o13-input o13-textarea o13-bordered o13-scrollable" name="system.story.credits.blocks.{{@key}}.entries" rows=8" scroll-id="story_credits_{{@key}}" style="flex:none;">{{lookup (lookup ../actor.system.story.credits.blocks @key) "entries"}}</textarea>
        </div>
    {{/each}}
</section>