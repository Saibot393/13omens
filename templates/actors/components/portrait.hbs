<div class="o13-portrait-container">
	<img class="o13-portrait" name="img" src="{{actor.img}}" title="{{actor.name}}" alt="{{actor.name}}" data-action="choosePortrait" />
	<i class="fa-solid fa-image o13-icon o13-bottom-right o13-hover-icon o13-clickable" data-action="viewPortrait" data-tooltip="{{localize "13omens.tooltips.viewPortrait"}}"></i>
	{{#if actor.tokenCreatorButton}}
		<i class="fa-regular fa-circle o13-icon o13-bottom-left o13-hover-icon o13-clickable" data-action="openTokenCreator" data-tooltip="{{localize "13omens.tooltips.openTokenCreator"}}"></i>
	{{/if}}
</div>