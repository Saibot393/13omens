{{> "systems/13omens/templates/actors/components/aspects.hbs" 
	aspectsname=(localize "13omens.titles.coreAspects")
	aspects=actor.system.aspects.core
	availableRatings=actor.system.availableRatings.core
	targetNumbers=actor.system.targetNumbers.core
	namepath="system.aspects.core."
	canPrepare=actor.canPrepare
}}

{{> "systems/13omens/templates/actors/components/aspects.hbs" 
	aspectsname=(localize "13omens.titles.storyAspects")
	aspects=actor.system.aspects.story
	aspectsnames=actor.storyAspectNames
	availableRatings=actor.system.availableRatings.story
	targetNumbers=actor.system.targetNumbers.story
	namepath="system.aspects.story."
	canPrepare=actor.canPrepare
}}

<div class="flexcol">
	<span class="o13-label o13-header-label">{{localize "13omens.titles.perks"}} </span>
	{{#if (and actor.canPrepare actor.choosablePerksCount)}}
		<span class="o13-label o13-side-padding" style="margin-bottom:5px;"> {{localize "13omens.titles.choosePerks" n=actor.choosablePerksCount}} </span>
	{{/if}}
	<div class="o13-adaptive-grid-wrapper">
		<div class="o13-adaptive-grid-23" sort-behaviour="AUTO">
			{{#each actor.perks}}
				{{#if (or ../actor.canPrepare this.isChosen)}}
					<div class="o13-side-padding o13-sortable draggable" draggable="true" perk-id="{{this._id}}">
						<span class="o13-label o13-inline" perk-id="{{this._id}}">
							<input class="o13-checkbox" type="checkbox" name="system.pickedperks.{{@key}}" {{#unless ../actor.canPrepare}}disabled{{/unless}} {{checked (lookup ../actor.system.pickedperks @key)}} /> 
							{{#unless this.isArchetypeOrigin}}
								{{#if ../actor.canPrepare}}
									<i class="fa-solid fa-x o13-label o13-icon o13-hover-icon o13-clickable" perk-id="{{this._id}}" data-action="removePerk"></i>
								{{/if}}
							{{/unless}}
							<b {{#if ../actor.isHostView}}class="o13-clickable" data-action="openPerk"{{/if}} perk-id="{{this._id}}">{{this.name}} </b> 
							<i class="fa-solid fa-message o13-icon o13-clickable o13-hover-icon" gear-id="{{this._id}}" data-action="posttoChat" perk-id="{{this._id}}"></i>
							{{{lookup (lookup ../enriched.perks this._id) "description"}}}
							{{#if (and this.canBeUsed this.isChosen)}}
								<span class="o13-button o13-clickable" data-action="usePerk" perk-id="{{this._id}}">{{localize "13omens.actions.usePerk"}} [{{this.usesLeft}}/{{this.usesMax}}]</span>
							{{/if }}
						</span>
					</div>
				{{/if}}
			{{/each}}
		</div>
	</div>
</div>

<div class="flexcol" style="margin-top:10px">
	<span class="o13-label o13-header-label">{{localize "13omens.titles.gears"}} <i class="fa-solid fa-plus o13-icon o13-clickable" data-action="createNewGear"></i> </span>
	<div class="o13-adaptive-grid-wrapper">
		{{#if actor.canPrepare}}
			{{#if actor.selectableGearCount}}
				<span class="o13-item-line" drop-zone="selectableGear">
					<span class="o13-label">
						<b>{{localize "13omens.titles.selectGear" n=actor.selectableGearCount}}:</b>
					</span>
					{{#each actor.selectableGearInfo}}
						<span class="o13-label o13-inline o13-item-box {{#if this.selected}}o13-selected{{/if}}" gear-id="{{this.id}}">
							<p class="o13-clickable" data-action="toggleSelectGear" gear-id="{{this.id}}">{{this.name}}</p> 
						</span>
					{{/each}}
				</span>
			{{/if}}
		{{/if}}
		<div class="o13-adaptive-grid-12" sort-direction="t_b" sort-behaviour="AUTO">
			{{#each actor.gear}}
				<div class="flexrow o13-side-padding o13-sortable draggable" draggable="true" gear-id="{{this._id}}" style="padding-top:1rem">
					<span class="o13-underline o13-flex-span">
						<span class="o13-label o13-clickable o13-flex-grow" gear-id="{{this._id}}" data-action="openGear">
							{{this.name}}
							<i class="fa-solid fa-message o13-icon o13-clickable o13-hover-icon" gear-id="{{this._id}}" data-action="posttoChat"></i>
						</span>
						<span class="o13-label o13-flex-center" gear-id="{{this._id}}" style="flex:0.4">
							<i class="fa-solid fa-burst o13-icon o13-clickable" gear-id="{{this._id}}" data-action="breakGear"></i>
							<span class="o13-label" gear-id="{{this._id}}">{{this.quantityValue}}</span>
							{{#if this.hasQuantityMax}}
								/ <span class="o13-label" gear-id="{{this._id}}">{{this.quantityMax}}</span>
							{{/if}}
							<i class="fa-solid fa-hammer o13-icon o13-clickable" gear-id="{{this._id}}" data-action="repairGear"></i>
						</span>
						<i class="fa-solid fa-x o13-label o13-icon o13-clickable o13-flex-right" gear-id="{{this._id}}" data-action="removeGear"></i>
					</span>
				</div>
			{{/each}}
		</div>
	</div>
</div>