<div class="actor-sheet-content o13-sheet o13-sheet-lining o13-scrollable flexcol">
	<header class="sheet-header flexrow">
		<div class="o13-portrait-container">
			<img class="o13-portrait" name="img" src="{{actor.img}}" title="{{actor.name}}" alt="{{actor.name}}" data-action="choosePortrait" />
			<i class="fa-solid fa-image o13-icon o13-bottom-right o13-hover-icon o13-clickable" data-action="viewPortrait" data-tooltip="{{localize "13omens.tooltips.viewPortrait"}}"></i>
		</div>
		<div class="flexcol">
			<div class="form-group flexrow">
				<label for="actor-name" class="o13-label" style="flex:0.5"><b>{{localize "13omens.titles.name"}}:</b></label>
				<input class="o13-input o13-underline" type="text" name="name" value="{{actor.name}}" />
			</div>
		</div>
	</header>
	<main class="flexcol">
		<nav class="o13-nav" nav-group="main" style="margin-bottom:3px">
			<a data-group="main" nav-tab="description">{{localize "13omens.titles.description"}}</a>
			<a data-group="main" nav-tab="inventory">{{localize "13omens.titles.inventory"}}</a>
		</nav>
		
		<section class="o13-tab o13-scrollable flexcol" nav-group="main" nav-tab="description" scroll-id="description">
			<div class="o13-notes flexcol">
				<prose-mirror
					class="o13-text-editor"
					name="system.description"
					document-uuid="{{actor.uuid}}"
					value="{{actor.system.description}}"
					button
					toggled
					editable
					collaborative="false"
					{{{enriched.description}}}
				</prose-mirror>
			</div>
		</section>
		
		<section class="o13-tab o13-scrollable flexcol" nav-group="main" nav-tab="inventory" scroll-id="inventory">
			<span class="o13-label o13-header-label">{{localize "13omens.titles.gears"}} <i class="fa-solid fa-plus o13-icon o13-clickable" data-action="createNewGear"></i> </span>
			{{> "systems/13omens/templates/actors/components/inventory.hbs" 
				actor=actor
				enriched=enriched
			}}
		</section>
	</main>
</div>