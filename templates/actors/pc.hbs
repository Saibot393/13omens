<div class="actor-sheet-content o13-sheet o13-sheet-lining o13-scrollable">
	<header class="sheet-header flexrow">
		<div class="o13-portrait-container">
			<img class="o13-portrait" name="img" src="{{actor.img}}" title="{{actor.name}}" alt="{{actor.name}}" data-action="choosePortrait" />
		</div>
		
		<div class="flexcol">
			<div class="form-group flexrow">
				<label for="actor-name" class="o13-label" style="flex:0.5"><b>{{localize "13omens.titles.name"}}:</b></label>
				<input class="o13-input o13-underline" type="text" name="name" value="{{actor.name}}" />
			</div>
			<div class="form-group flexrow">
				<label for="actor-name" class="o13-label" style="flex:0.5">{{localize "13omens.titles.traits"}}:</label>
				<input class="o13-input o13-underline" type="text" name="system.traits" value="{{actor.system.traits}}" />
			</div>
			{{#if actor.storyActor}}
				<div class="form-group flexrow">
					<label for="story-name" class="o13-label" style="flex:0.5">{{localize "13omens.titles.story"}}:</label>
					<span class="o13-input o13-underline" type="text">{{actor.storyActor.name}}</span>
				</div>
			{{/if}}
			<div class="form-group flexrow">
				<label for="actor-name" class="o13-label" style="flex:0.5">{{localize "13omens.titles.archetype"}}:</label>
				<select class="o13-input o13-underline" name="system.archetype">
					<option value=""></option>
					{{#each actor.availableArchetype as |archetype|}}
						<option value="{{archetype.id}}" {{#if (eq archetype.id ../actor.system.archetype)}}selected{{/if}}>{{archetype.name}}</option>
					{{/each}}
				</select>
			</div>
		</div>
		
		<div class="o13-wound-dice flexcol" style="min-width: 150px; place-content: center;">
			{{> "systems/13omens/templates/dice/dicebag.hbs" 
				dice=actor.woundDice
			}}
		</div>
	</header>
	
	<main>
		{{> "systems/13omens/templates/actors/components/aspects.hbs" 
			aspectsname=(localize "13omens.titles.coreAspects")
			aspects=actor.system.aspects.core
			availableRatings=actor.system.availableRatings.core
			targetNumbers=actor.system.targetNumbers.core
			namepath="system.aspects.core."
		}}
		
		{{> "systems/13omens/templates/actors/components/aspects.hbs" 
			aspectsname=(localize "13omens.titles.storyAspects")
			aspects=actor.system.aspects.story
			aspectsnames=actor.storyAspectNames
			availableRatings=actor.system.availableRatings.story
			targetNumbers=actor.system.targetNumbers.story
			namepath="system.aspects.story."
		}}
		
		<span class="o13-label o13-header-label">{{localize "13omens.titles.perks"}} </span>
		{{! <div style="display:grid;grid-template-columns: repeat(2, 1fr);gap: 1rem;">}}
		<div class="o13-adaptive-grid-wrapper">
			<div class="o13-adaptive-grid-23">
				{{#each actor.perks}}
					<span class="o13-label o13-inline" perk-id="{{this._id}}">
						<input class="o13-checkbox" type="checkbox" name="system.pickedperks.{{@key}}" {{checked (lookup ../actor.system.pickedperks @key)}} /> 
						{{#unless this.isArchetypeOrigin}}
							<i class="fa-solid fa-x o13-label o13-icon o13-hover-icon o13-clickable" perk-id="{{this._id}}" data-action="removePerk"></i>
						{{/unless}}
						<b data-action="openPerk" perk-id="{{this._id}}">{{this.name}}</b> {{{this.system.description}}}
					</span>
				{{/each}}
			</div>
		</div>
	</main>
</div>