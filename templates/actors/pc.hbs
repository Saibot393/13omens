<div class="actor-sheet-content o13-sheet o13-sheet-lining flexcol">
	<header class="sheet-header flexrow">
		<div class="o13-portrait-container">
			<img class="o13-portrait" name="img" src="{{actor.img}}" title="{{actor.name}}" alt="{{actor.name}}" data-action="choosePortrait" />
		</div>
		
		<div class="flexcol">
			<div class="form-group flexrow">
				<label for="actor-name" class="o13-label" style="flex:0.5"><b>{{localize "13omens.titles.name"}}:</b></label>
				<input class="o13-input o13-underline" type="text" name="name" value="{{actor.name}}" />
			</div>
			<div class="form-group flexrow">
				<label for="actor-name" class="o13-label" style="flex:0.5">{{localize "13omens.titles.traits"}}:</label>
				<input class="o13-input o13-underline" type="text" name="system.traits" value="{{actor.system.traits}}" />
			</div>
			{{#if actor.storyActor}}
				<div class="form-group flexrow">
					<label for="story-name" class="o13-label" style="flex:0.5">{{localize "13omens.titles.story"}}:</label>
					<span class="o13-input o13-underline" type="text">{{actor.storyActor.name}}</span>
				</div>
			{{/if}}
			<div class="form-group flexrow">
				<label for="actor-name" class="o13-label" style="flex:0.5">{{localize "13omens.titles.archetype"}}:</label>
				<select class="o13-input o13-underline" name="system.archetype">
					<option value=""></option>
					{{#each actor.availableArchetype as |archetype|}}
						<option value="{{archetype.id}}" {{#if (eq archetype.id ../actor.system.archetype)}}selected{{/if}}>{{archetype.name}}</option>
					{{/each}}
				</select>
			</div>
		</div>
		
		<div class="flexcol">
			<div class="flexrow">
				<div class="o13-wound-dice flexcol" style="min-width: 150px; place-content: center;">
					{{> "systems/13omens/templates/dice/dicebag.hbs" 
						dice=actor.woundDice
					}}
				</div>
			</div>
			
			{{#if actor.isHostView}}
				<div class="o13-hover-div" style="min-height: 40px;"></div>
				<div class="flexrow o13-bordered o13-hover-div" style="margin: 0px auto;gap: min(2vw, 20px);max-width: 150px;">
					<i class="fa-solid fa-droplet o13-icon o13-hover-field-icon o13-clickable" style="color:var(--o13-omen-red)" data-action="takeWound" data-tooltip="{{localize '13omens.tooltips.takeWound'}}"></i>
					<i class="fa-solid fa-hourglass-half o13-icon o13-hover-field-icon o13-clickable" style="color:var(--o13-cheat-blue)" data-action="cheatDeath" data-tooltip="{{localize '13omens.tooltips.cheatDeath'}}"></i>
					<i class="fa-solid fa-rotate-left o13-icon o13-hover-field-icon o13-clickable" style="color:var(--o13-ink-black)" data-action="clearWound" data-tooltip="{{localize '13omens.tooltips.clearWound'}}"></i>
				</div>
			{{/if}}
		</div>
	</header>
	
	<main class="o13-scrollable" style="flex:1" scroll-id="main">
		{{> "systems/13omens/templates/actors/components/aspects.hbs" 
			aspectsname=(localize "13omens.titles.coreAspects")
			aspects=actor.system.aspects.core
			availableRatings=actor.system.availableRatings.core
			targetNumbers=actor.system.targetNumbers.core
			namepath="system.aspects.core."
		}}
		
		{{> "systems/13omens/templates/actors/components/aspects.hbs" 
			aspectsname=(localize "13omens.titles.storyAspects")
			aspects=actor.system.aspects.story
			aspectsnames=actor.storyAspectNames
			availableRatings=actor.system.availableRatings.story
			targetNumbers=actor.system.targetNumbers.story
			namepath="system.aspects.story."
		}}
		
		<div class="flexcol">
			<span class="o13-label o13-header-label">{{localize "13omens.titles.perks"}} </span>
			<div class="o13-adaptive-grid-wrapper">
				<div class="o13-adaptive-grid-23">
					{{#each actor.perks}}
						<div class="o13-side-padding">
							<span class="o13-label o13-inline" perk-id="{{this._id}}">
								<input class="o13-checkbox" type="checkbox" name="system.pickedperks.{{@key}}" {{checked (lookup ../actor.system.pickedperks @key)}} /> 
								{{#unless this.isArchetypeOrigin}}
									<i class="fa-solid fa-x o13-label o13-icon o13-hover-icon o13-clickable" perk-id="{{this._id}}" data-action="removePerk"></i>
								{{/unless}}
								<b data-action="openPerk" perk-id="{{this._id}}">{{this.name}}</b> {{{this.system.description}}}
							</span>
						</div>
					{{/each}}
				</div>
			</div>
		</div>
		
		<div class="flexcol" style="margin-top:10px">
			<span class="o13-label o13-header-label">{{localize "13omens.titles.gears"}} </span>
			<div class="o13-adaptive-grid-wrapper">
				{{#if actor.selectableGearCount}}
					<span class="o13-item-line" drop-zone="selectableGear">
						<span class="o13-label"><b>{{localize "13omens.titles.selectGear" n=actor.selectableGearCount}}:</b></span>
						{{#each actor.selectableGearInfo}}
							<span class="o13-label o13-inline o13-item-box {{#if this.selected}}o13-selected{{/if}}" gear-id="{{this.id}}">
								<p class="o13-clickable" data-action="toggleSelectGear" gear-id="{{this.id}}">{{this.name}}</p> 
							</span>
						{{/each}}
					</span>
				{{/if}}
				<div class="o13-adaptive-grid-12" style="margin-top:15px">
					{{#each actor.gear}}
						<div class="flexrow o13-side-padding">
							<span class="o13-underline o13-flex-span">
								<span class="o13-label o13-clickable o13-flex-grow" gear-id="{{this._id}}" data-action="openGear">{{this.name}}</span>
								<span class="o13-label o13-flex-center" gear-id="{{this._id}}" style="flex:0.4">
									<i class="fa-solid fa-burst o13-icon o13-clickable" gear-id="{{this._id}}" data-action="breakGear"></i>
										<span class="o13-label" gear-id="{{this._id}}">{{this.quantityValue}}</span>
										{{#if this.hasQuantityMax}}
											/ <span class="o13-label" gear-id="{{this._id}}">{{this.quantityMax}}</span>
										{{/if}}
									<i class="fa-solid fa-hammer o13-icon o13-clickable" gear-id="{{this._id}}" data-action="repairGear"></i>
								</span>
								<i class="fa-solid fa-x o13-label o13-icon o13-clickable o13-flex-right" gear-id="{{this._id}}" data-action="removeGear"></i>
							</span>
						</div>
					{{/each}}
				</div>
			</div>
		</div>
	</main>
</div>