<div class="actor-sheet-content o13-sheet o13-sheet-lining flexcol">
	<header class="sheet-header flexrow">
		<div class="o13-portrait-container">
			<img class="o13-portrait" name="img" src="{{actor.img}}" title="{{actor.name}}" alt="{{actor.name}}" data-action="choosePortrait" />
			<i class="fa-solid fa-image o13-icon o13-bottom-right o13-hover-icon o13-clickable" data-action="viewPortrait" data-tooltip="{{localize "13omens.tooltips.viewPortrait"}}"></i>
		</div>
		
		<div class="flexcol">
			<div class="form-group flexrow">
				<label for="actor-name" class="o13-label" style="flex:0.5"><b>{{localize "13omens.titles.name"}}:</b></label>
				<input class="o13-input o13-underline" type="text" name="name" value="{{actor.name}}" />
			</div>
			<div class="form-group flexrow">
				<label for="traits" class="o13-label" style="flex:0.5">{{localize "13omens.titles.traits"}}:</label>
				<input class="o13-input o13-underline" type="text" name="system.traits" value="{{actor.system.traits}}" />
			</div>
			{{#if actor.storyActor}}
				<div class="form-group flexrow"  style="min-height:32px">
					<label for="story-name" class="o13-label" style="flex:0.5">{{localize "13omens.titles.story"}}:</label>
					<span class="o13-input o13-underline o13-clickable" type="text" data-action="viewStory" style="align-self:flex-end;padding-bottom:3px;">{{actor.storyActor.name}}</span>
				</div>
			{{/if}}
			<div class="form-group flexrow">
				<label for="archetype-name" class="o13-label" style="flex:0.5">{{localize "13omens.titles.archetype"}}:</label>
				<select class="o13-input o13-underline" name="system.archetype" {{#unless actor.canPrepare}}disabled{{/unless}}>
					<option value=""></option>
					{{#each actor.availableArchetype as |archetype|}}
						<option value="{{archetype.id}}" {{#if (eq archetype.id ../actor.system.archetype)}}selected{{/if}}>{{archetype.name}}</option>
					{{/each}}
				</select>
			</div>
		</div>
		
		<div class="flexcol">
			<div class="flexrow">
				<div class="o13-wound-dice flexcol" style="min-width: 150px; place-content: center;">
					{{> "systems/13omens/templates/dice/dicebag.hbs" 
						dice=actor.woundDice
					}}
				</div>
			</div>
			
			{{#if actor.isHostView}}
				<div class="o13-hover-div" style="min-height: 40px;"></div>
				<div class="flexrow o13-bordered o13-hover-div" style="margin: 0px auto;gap: min(2vw, 20px);max-width: 150px;">
					{{#unless actor.isDead}}
						{{#unless actor.woundsFilled}}
							<i class="fa-solid fa-droplet o13-icon o13-hover-field-icon o13-clickable" style="color:var(--o13-omen-red)" data-action="takeWound" data-tooltip="{{localize "13omens.tooltips.takeWound"}}"></i>
							<i class="fa-solid fa-hourglass-half o13-icon o13-hover-field-icon o13-clickable" style="color:var(--o13-cheat-blue)" data-action="cheatDeath" data-tooltip="{{localize "13omens.tooltips.cheatDeath"}}"></i>
						{{else}}
							<i class="fa-solid fa-skull o13-icon o13-hover-field-icon o13-clickable" style="color:var(--o13-omen-red)" data-action="kill" data-tooltip="{{localize "13omens.tooltips.kill"}}"></i>
						{{/unless}}
					{{/unless}}
					{{#if actor.isDead}}
						<i class="fa-solid fa-skull o13-icon o13-hover-field-icon o13-clickable" style="color:var(--o13-cheat-blue)" data-action="revive" data-tooltip="{{localize "13omens.tooltips.revive"}}"></i>
					{{/if}}
					<i class="fa-solid fa-rotate-left o13-icon o13-hover-field-icon o13-clickable" style="color:var(--o13-ink-black)" data-action="clearWound" data-tooltip="{{localize "13omens.tooltips.clearWound"}}"></i>
				</div>
			{{/if}}
		</div>
	</header>
	
	<main class="flexcol">
		<nav class="o13-nav" nav-group="main">
			<a data-group="main" nav-tab="character">{{localize "13omens.titles.character"}}</a>
			<a data-group="main" nav-tab="background">{{localize "13omens.titles.background"}}</a>
		</nav>
	
		<section class="o13-tab o13-scrollable flexcol" nav-group="main" nav-tab="character" scroll-id="character">
			{{> "systems/13omens/templates/actors/components/pc_character.hbs" 
				actor=actor
				enriched=enriched
			}}
		</section>
		
		<section class="o13-tab o13-scrollable flexcol" nav-group="main" nav-tab="background" scroll-id="background">
			{{> "systems/13omens/templates/actors/components/pc_background.hbs" 
				actor=actor
				enriched=enriched
			}}
		</section>
	</main>
</div>