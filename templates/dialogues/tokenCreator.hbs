<div>
	<div style="min-width:650px;min-height:650px;overflow:hidden;">
		<img class="o13-placement-image" name="img" src="{{creator.imageSource}}" style="position:absolute;scale:100%"/>
		
		<div class="o13-token-ring o13-outer" style="width: 300px; height: 300px;border-width:13px"></div>
		<div class="o13-token-ring o13-inner" style="width: 278px; height: 278px;border-width:2px"></div>
	</div>
	
	<div class = "flexrow">
		<button class="o13-button o13-clickable" type="button" data-action="setToken">{{localize "13omens.actions.setToken"}} <i class="fa-regular fa-circle"></i> </button>
		<button class="o13-button o13-clickable" type="button" data-action="cancel">{{localize "13omens.actions.cancel"}} <i class="fa-solid fa-arrow-rotate-left"></i> </button>
	</div>
</div>