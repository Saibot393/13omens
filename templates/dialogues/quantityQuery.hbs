<div class="o13-sheet">
	<span class="o13-header-label"><b>{{quantityQuery.query}}</b></span>
	<range-picker name="value" value="{{quantityQuery.value}}" min="{{quantityQuery.min}}" max="{{quantityQuery.max}}" step="1" style="margin:5px"></range-picker>
	
	<div class="flexrow" style="gap:5px">
		<button class="o13-button o13-clickable" type="button" data-action="accept">{{localize "13omens.actions.accept"}} <i class="fa-solid fa-check"></i> </button>
		<button class="o13-button o13-clickable" type="button" data-action="cancel">{{localize "13omens.actions.cancel"}} <i class="fa-solid fa-x"></i> </button>
	</div>
</div>